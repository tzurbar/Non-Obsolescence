---
import Layout from '../../layouts/Layout.astro';
import SubmitForm from '../../components/SubmitForm.astro';
import { getCollection } from 'astro:content';
import { t as uiT } from '../../lib/i18n';
import { byLocale, defaultLocale } from '../../lib/content';

const categories = byLocale(await getCollection('categoriesGuides'), defaultLocale);
---

<Layout title={uiT(defaultLocale).submit.title}>
  <SubmitForm locale={defaultLocale} categories={categories} />
</Layout>
