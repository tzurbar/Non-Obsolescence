---
import Layout from '../../../layouts/Layout.astro';
import SubmitForm from '../../../components/SubmitForm.astro';
import { getCollection } from 'astro:content';
import { t as uiT } from '../../../lib/i18n';
import { byLocale, locales, defaultLocale } from '../../../lib/content';

export async function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const categories = byLocale(await getCollection('categoriesGuides'), locale);
---

<Layout title={uiT(locale).submit.title}>
  <SubmitForm locale={locale} categories={categories} />
</Layout>
