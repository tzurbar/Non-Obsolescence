---
import Layout from '../../../layouts/Layout.astro';
import SubmitForm from '../../../components/SubmitForm.astro';
import { t as uiT } from '../../../lib/i18n';
import { locales, defaultLocale } from '../../../lib/content';

export async function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<Layout title={uiT(locale).submit.title}>
  <SubmitForm locale={locale} />
</Layout>
