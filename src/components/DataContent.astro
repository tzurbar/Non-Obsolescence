---
import CategoryFilter from './CategoryFilter.astro';
import MaterialCard from './MaterialCard.astro';
import ReliabilityTable from './ReliabilityTable.astro';
import DisclosureChevron from './DisclosureChevron.astro';
import { t as uiT } from '../lib/i18n';
import { flattenIndented, ancestorChainIds } from '../lib/categories';
import { slugOf } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: string;
  fixability: CollectionEntry<'fixability'>[];
  materials: CollectionEntry<'materials'>[];
  fixabilityCategories: CollectionEntry<'categoriesFixability'>[];
  materialsCategories: CollectionEntry<'categoriesMaterials'>[];
}

const { locale, fixability, materials, fixabilityCategories, materialsCategories } = Astro.props;
const s = uiT(locale).data;
const fixNodes = flattenIndented(fixabilityCategories);
const matNodes = flattenIndented(materialsCategories);
const fixLabelOf = (id?: string) => (id && fixabilityCategories.find((c) => slugOf(c.id) === id)?.data.label) || '';

// The materials list is grouped into its category tree - family, then
// sub-family - rather than shown flat, because the whole point of the page
// is comparing like with like. Families are ordered by how often a DIYer
// actually reaches for each one (see the `order` field on those categories),
// not alphabetically.
const itemsIn = (categoryId: string) => materials.filter((m) => m.data.categoryId === categoryId);
const sections = matNodes
  .filter((node) => node.depth === 0)
  .map((node) => ({
    ...node,
    direct: itemsIn(node.id),
    subsections: matNodes
      .filter((child) => child.parentId === node.id)
      .map((child) => ({ ...child, items: itemsIn(child.id) }))
      .filter((child) => child.items.length > 0)
  }))
  .filter((section) => section.direct.length > 0 || section.subsections.length > 0);

// Anything pointing at a category that no longer exists still gets shown,
// rather than silently vanishing from the page.
const placed = new Set(sections.flatMap((sec) => [...sec.direct, ...sec.subsections.flatMap((sub) => sub.items)]));
const unplaced = materials.filter((m) => !placed.has(m));
---

<section class="max-w-5xl mx-auto px-4 py-12">
  <h1 class="text-3xl font-bold mb-2">{s.title}</h1>
  <p class="text-stone-600 mb-10 max-w-2xl">{s.subtitle}</p>

  <h2 class="text-xl font-bold mb-4">{s.materialsHeading}</h2>
  <CategoryFilter nodes={matNodes} scopeId="materials" allLabel={s.allCategories} searchPlaceholder={s.searchMaterialsPlaceholder} />

  <div data-filter-target="materials" class="mb-16">
    {sections.map((section) => (
      <details class="group/family border border-stone-200 rounded-lg bg-white mb-3 overflow-hidden" data-filter-group>
        <summary class="list-none cursor-pointer select-none px-5 py-3 flex items-center justify-between gap-3 hover:bg-stone-50 [&::-webkit-details-marker]:hidden">
          <span class="text-lg font-bold text-stone-900">{section.label}</span>
          <DisclosureChevron level="family" />
        </summary>

        <div class="px-5 pb-4 pt-1 border-t border-stone-100 space-y-3">
          {section.direct.length > 0 && (
            <div class="space-y-2 pt-3">
              {section.direct.map((entry) => (
                <MaterialCard entry={entry} categories={materialsCategories} locale={locale} />
              ))}
            </div>
          )}

          {section.subsections.map((sub) => (
            <details class="group/sub border border-stone-200 rounded-lg bg-stone-50 mt-3 overflow-hidden" data-filter-group>
              <summary class="list-none cursor-pointer select-none px-4 py-2.5 flex items-center justify-between gap-3 hover:bg-stone-100 [&::-webkit-details-marker]:hidden">
                <span class="text-sm font-semibold uppercase tracking-wide text-emerald-700">{sub.label}</span>
                <DisclosureChevron level="sub" />
              </summary>
              <div class="p-3 pt-2 space-y-2 border-t border-stone-200">
                {sub.items.map((entry) => (
                  <MaterialCard entry={entry} categories={materialsCategories} locale={locale} />
                ))}
              </div>
            </details>
          ))}
        </div>
      </details>
    ))}

    {unplaced.length > 0 && (
      <div class="space-y-2" data-filter-group>
        {unplaced.map((entry) => (
          <MaterialCard entry={entry} categories={materialsCategories} locale={locale} />
        ))}
      </div>
    )}

    <p class="text-stone-500" data-empty-state style="display: none">{s.noResults}</p>
  </div>

  <h2 class="text-xl font-bold mb-4">{s.fixabilityHeading}</h2>
  <CategoryFilter nodes={fixNodes} scopeId="fixability" allLabel={s.allCategories} searchPlaceholder={s.searchFixabilityPlaceholder} />
  <div class="space-y-4 mb-16" data-filter-target="fixability">
    {fixability.map((entry) => (
      <div
        class="border border-stone-200 rounded-lg p-5"
        data-search={`${entry.data.brand} ${fixLabelOf(entry.data.categoryId)}`.toLowerCase()}
        data-ancestors={ancestorChainIds(fixabilityCategories, entry.data.categoryId).join(',')}
      >
        <div class="flex items-center justify-between">
          <h3 class="font-semibold">{entry.data.brand} &mdash; {fixLabelOf(entry.data.categoryId)}</h3>
          <span class="text-emerald-700 font-bold">{entry.data.score.toFixed(1)}/10</span>
        </div>
        <p class="mt-2 text-sm text-stone-600">{entry.data.summary}</p>
      </div>
    ))}
    <p class="text-stone-500" data-empty-state style="display: none">{s.noResults}</p>
  </div>

  <h2 class="text-xl font-bold mb-2">{s.reliabilityHeading}</h2>
  <p class="text-sm text-stone-500 mb-4 max-w-2xl">{s.reliabilitySubtitle}</p>
  <ReliabilityTable entries={fixability} locale={locale} />
</section>
