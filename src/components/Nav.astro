---
const locales = [
  { code: 'en', label: 'English' },
  { code: 'he', label: 'עברית' },
  { code: 'ar', label: 'العربية' },
  { code: 'es', label: 'Español' },
  { code: 'pt', label: 'Português' }
];

const currentLocale = Astro.currentLocale ?? 'en';
---

<header class="border-b border-stone-200 bg-white">
  <div class="max-w-5xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4">
    <a href="/" class="text-lg font-bold tracking-tight text-emerald-700">Non-Obsolescence</a>
    <nav class="flex items-center gap-6 text-sm font-medium text-stone-600">
      <a href="/guides" class="hover:text-emerald-700">Guides</a>
      <a href="/data" class="hover:text-emerald-700">Data</a>
      <a href="/submit" class="hover:text-emerald-700">Submit</a>
      <select
        id="language-select"
        class="border border-stone-300 rounded-md px-2 py-1 text-sm bg-white"
        data-current={currentLocale}
      >
        {locales.map((locale) => (
          <option value={locale.code} selected={locale.code === currentLocale}>
            {locale.label}
          </option>
        ))}
      </select>
    </nav>
  </div>
</header>

<script>
  const select = document.getElementById('language-select') as HTMLSelectElement | null;
  select?.addEventListener('change', () => {
    const target = select.value;
    const current = select.dataset.current ?? 'en';
    if (target === current) return;
    const path = window.location.pathname;
    const segments = path.split('/').filter(Boolean);
    const knownLocales = ['he', 'ar', 'es', 'pt'];
    if (knownLocales.includes(segments[0])) segments.shift();
    const prefix = target === 'en' ? '' : `/${target}`;
    window.location.pathname = `${prefix}/${segments.join('/')}`.replace(/\/+$/, '') || '/';
  });
</script>
