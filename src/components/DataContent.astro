---
import CategoryFilter from './CategoryFilter.astro';
import { t as uiT } from '../lib/i18n';
import { flattenIndented, ancestorChainIds } from '../lib/categories';
import { slugOf } from '../lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: string;
  fixability: CollectionEntry<'fixability'>[];
  materials: CollectionEntry<'materials'>[];
  fixabilityCategories: CollectionEntry<'categoriesFixability'>[];
  materialsCategories: CollectionEntry<'categoriesMaterials'>[];
}

const { locale, fixability, materials, fixabilityCategories, materialsCategories } = Astro.props;
const s = uiT(locale).data;
const fixNodes = flattenIndented(fixabilityCategories);
const matNodes = flattenIndented(materialsCategories);
const fixLabelOf = (id?: string) => (id && fixabilityCategories.find((c) => slugOf(c.id) === id)?.data.label) || '';
const matLabelOf = (id?: string) => (id && materialsCategories.find((c) => slugOf(c.id) === id)?.data.label) || '';
---

<section class="max-w-5xl mx-auto px-4 py-12">
  <h1 class="text-3xl font-bold mb-2">{s.title}</h1>
  <p class="text-stone-600 mb-10 max-w-2xl">{s.subtitle}</p>

  <h2 class="text-xl font-bold mb-4">{s.fixabilityHeading}</h2>
  <CategoryFilter nodes={fixNodes} scopeId="fixability" allLabel={s.allCategories} searchPlaceholder={s.searchFixabilityPlaceholder} />
  <div class="space-y-4 mb-12" data-filter-target="fixability">
    {fixability.map((entry) => (
      <div
        class="border border-stone-200 rounded-lg p-5"
        data-search={`${entry.data.brand} ${fixLabelOf(entry.data.categoryId)}`.toLowerCase()}
        data-ancestors={ancestorChainIds(fixabilityCategories, entry.data.categoryId).join(',')}
      >
        <div class="flex items-center justify-between">
          <h3 class="font-semibold">{entry.data.brand} &mdash; {fixLabelOf(entry.data.categoryId)}</h3>
          <span class="text-emerald-700 font-bold">{entry.data.score.toFixed(1)}/10</span>
        </div>
        <p class="mt-2 text-sm text-stone-600">{entry.data.summary}</p>
      </div>
    ))}
    <p class="text-stone-500" data-empty-state style="display: none">{s.noResults}</p>
  </div>

  <h2 class="text-xl font-bold mb-4">{s.materialsHeading}</h2>
  <CategoryFilter nodes={matNodes} scopeId="materials" allLabel={s.allCategories} searchPlaceholder={s.searchMaterialsPlaceholder} />
  <div class="grid gap-4 sm:grid-cols-2" data-filter-target="materials">
    {materials.map((entry) => (
      <div
        class="border border-stone-200 rounded-lg p-5"
        data-search={`${entry.data.name} ${matLabelOf(entry.data.categoryId)}`.toLowerCase()}
        data-ancestors={ancestorChainIds(materialsCategories, entry.data.categoryId || '').join(',')}
      >
        <h3 class="font-semibold">{entry.data.name}</h3>
        <p class="mt-1 text-xs text-stone-500 uppercase tracking-wide">
          {matLabelOf(entry.data.categoryId)}{entry.data.categoryId ? ' · ' : ''}{s.durability}: {entry.data.durability} &middot; {s.recyclability}: {entry.data.recyclability}
        </p>
        <p class="mt-2 text-sm text-stone-600">{entry.data.summary}</p>
      </div>
    ))}
    <p class="text-stone-500" data-empty-state style="display: none">{s.noResults}</p>
  </div>
</section>
