---
import { githubRepoUrl } from '../lib/content';
import { t as uiT } from '../lib/i18n';
import { flattenIndented } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: string;
  categories: CollectionEntry<'categoriesGuides'>[];
}

const { locale, categories } = Astro.props;
const s = uiT(locale).submit;
const issueFormHref = `${githubRepoUrl}/issues/new?template=submit-guide.yml`;
const categoryNodes = flattenIndented(categories);
---

<section class="max-w-2xl mx-auto px-4 py-12">
  <h1 class="text-3xl font-bold mb-2">{s.title}</h1>
  <p class="text-stone-600 mb-8">{s.intro}</p>

  <form id="guide-form" class="space-y-6" novalidate>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block sm:col-span-2">
        <span class="text-sm font-semibold text-stone-700">{s.titleLabel} *</span>
        <input name="title" required class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2" placeholder={s.titlePlaceholder} />
      </label>
      <label class="block">
        <span class="text-sm font-semibold text-stone-700">{s.productLabel} *</span>
        <input name="productName" required class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2" />
      </label>
      <div class="block">
        <span class="text-sm font-semibold text-stone-700">{s.categoryLabel} *</span>
        <input
          type="text"
          id="category-search"
          class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2 text-sm"
          placeholder={s.categorySearchPlaceholder}
          autocomplete="off"
        />
        <select id="category-select" class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2 bg-white">
          <option value="" disabled selected>{s.categorySelectPlaceholder}</option>
          {categoryNodes.map((n) => (
            <option value={n.id} data-label={n.label}>{'—'.repeat(n.depth)} {n.label}</option>
          ))}
          <option value="__new__">{s.categoryNotListed}</option>
        </select>
        <input
          type="text"
          name="newCategoryLabel"
          id="new-category-input"
          class="hidden mt-2 w-full border border-stone-300 rounded-md px-3 py-2 text-sm"
          placeholder={s.newCategoryPlaceholder}
        />
        <p id="category-error" class="hidden mt-1 text-xs text-red-600">{s.categoryRequiredError}</p>
      </div>
      <label class="block">
        <span class="text-sm font-semibold text-stone-700">{s.difficultyLabel} *</span>
        <select name="difficulty" required class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2 bg-white">
          <option value="beginner">{s.beginner}</option>
          <option value="intermediate">{s.intermediate}</option>
          <option value="advanced">{s.advanced}</option>
        </select>
      </label>
      <label class="block">
        <span class="text-sm font-semibold text-stone-700">{s.estimatedTimeLabel} *</span>
        <input name="estimatedTime" required class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2" placeholder={s.estimatedTimePlaceholder} />
      </label>
    </div>

    <div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-stone-700">{s.toolsLabel}</span>
        <button type="button" id="add-tool" class="text-sm text-emerald-700 hover:underline">{s.addTool}</button>
      </div>
      <div id="tools-list" class="space-y-2"></div>
    </div>

    <div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-stone-700">{s.partLinksLabel}</span>
        <button type="button" id="add-part-link" class="text-sm text-emerald-700 hover:underline">{s.addPartLink}</button>
      </div>
      <div id="part-links-list" class="space-y-2"></div>
    </div>

    <div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-stone-700">{s.videoLinksLabel}</span>
        <button type="button" id="add-video-link" class="text-sm text-emerald-700 hover:underline">{s.addVideoLink}</button>
      </div>
      <div id="video-links-list" class="space-y-2"></div>
    </div>

    <label class="block">
      <span class="text-sm font-semibold text-stone-700">{s.coverPhotoLabel}</span>
      <input type="file" name="coverImage" accept="image/jpeg,image/png,image/webp,image/gif" class="mt-1 w-full text-sm" />
      <span class="text-xs text-stone-500">{s.coverPhotoHelp}</span>
    </label>

    <div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-stone-700">{s.stepsLabel} *</span>
        <button type="button" id="add-step" class="text-sm text-emerald-700 hover:underline">{s.addStep}</button>
      </div>
      <div id="steps-list" class="space-y-4"></div>
    </div>

    <label class="block">
      <span class="text-sm font-semibold text-stone-700">{s.notesLabel}</span>
      <textarea name="notes" rows="3" class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2"></textarea>
    </label>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-sm font-semibold text-stone-700">{s.authorLabel}</span>
        <input name="authorName" class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2" />
      </label>
      <label class="block">
        <span class="text-sm font-semibold text-stone-700">{s.authorContactLabel}</span>
        <input name="authorContact" class="mt-1 w-full border border-stone-300 rounded-md px-3 py-2" placeholder={s.authorContactPlaceholder} />
      </label>
    </div>

    <label class="hidden" aria-hidden="true">
      Leave this empty
      <input name="website" tabindex="-1" autocomplete="off" />
    </label>

    <div>
      <button type="submit" id="submit-btn" class="bg-emerald-700 text-white font-semibold px-6 py-3 rounded-lg hover:bg-emerald-800 transition disabled:opacity-50">
        {s.submitButton}
      </button>
      <p id="form-status" class="mt-3 text-sm" role="status"></p>
    </div>
  </form>

  <p class="mt-10 text-sm text-stone-500">
    {s.githubPrompt}
    <a href={issueFormHref} target="_blank" rel="noopener" class="text-emerald-700 hover:underline">{s.githubLink}</a>.
  </p>
</section>

<template id="step-template">
  <div class="step-row border border-stone-200 rounded-lg p-4 space-y-2">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-stone-500 step-number"></span>
      <button type="button" class="remove-step text-xs text-red-600 hover:underline">{s.remove}</button>
    </div>
    <textarea class="step-text w-full border border-stone-300 rounded-md px-3 py-2 text-sm" rows="2" placeholder={s.stepPlaceholder}></textarea>
    <input type="file" class="step-image text-sm" accept="image/jpeg,image/png,image/webp,image/gif" title={s.stepImageTitle} />
  </div>
</template>

<template id="tool-template">
  <div class="tool-row flex items-center gap-2">
    <input class="tool-input flex-1 border border-stone-300 rounded-md px-3 py-2 text-sm" placeholder={s.toolPlaceholder} />
    <button type="button" class="remove-tool text-xs text-red-600 hover:underline">{s.remove}</button>
  </div>
</template>

<template id="link-row-template">
  <div class="link-row grid gap-2 sm:grid-cols-[1fr_1fr_auto] items-center">
    <input class="link-name border border-stone-300 rounded-md px-3 py-2 text-sm" placeholder={s.linkNamePlaceholder} />
    <input class="link-url border border-stone-300 rounded-md px-3 py-2 text-sm" type="url" placeholder={s.linkUrlPlaceholder} />
    <button type="button" class="remove-link text-xs text-red-600 hover:underline">{s.remove}</button>
  </div>
</template>

<script define:vars={{ strings: { stepNumber: s.stepNumber, submitting: s.submitting, submitted: s.submitted, viewSubmission: s.viewSubmission, genericError: s.genericError, networkError: s.networkError, categoryRequiredError: s.categoryRequiredError } }}>
  const form = document.getElementById('guide-form');
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  // --- Steps (unchanged pattern: text + optional photo, no per-step links anymore) ---
  const stepsList = document.getElementById('steps-list');
  const stepTemplate = document.getElementById('step-template');

  function renumberSteps() {
    stepsList.querySelectorAll('.step-row').forEach((row, i) => {
      const label = row.querySelector('.step-number');
      if (label) label.textContent = `${strings.stepNumber} ${i + 1}`;
    });
  }

  function addStep() {
    const node = stepTemplate.content.cloneNode(true);
    node.querySelector('.remove-step')?.addEventListener('click', (e) => {
      e.target.closest('.step-row')?.remove();
      renumberSteps();
    });
    stepsList.appendChild(node);
    renumberSteps();
  }

  document.getElementById('add-step')?.addEventListener('click', addStep);
  addStep();
  addStep();

  // --- Tools: one input per tool, added one at a time ---
  const toolsList = document.getElementById('tools-list');
  const toolTemplate = document.getElementById('tool-template');

  function addTool() {
    const node = toolTemplate.content.cloneNode(true);
    node.querySelector('.remove-tool')?.addEventListener('click', (e) => e.target.closest('.tool-row')?.remove());
    toolsList.appendChild(node);
  }

  document.getElementById('add-tool')?.addEventListener('click', addTool);
  addTool();

  // --- Part links / video links: guide-level only, name+URL pairs ---
  const partLinksList = document.getElementById('part-links-list');
  const videoLinksList = document.getElementById('video-links-list');
  const linkRowTemplate = document.getElementById('link-row-template');

  function addLinkRow(container) {
    const node = linkRowTemplate.content.cloneNode(true);
    node.querySelector('.remove-link')?.addEventListener('click', (e) => e.target.closest('.link-row')?.remove());
    container.appendChild(node);
  }

  document.getElementById('add-part-link')?.addEventListener('click', () => addLinkRow(partLinksList));
  document.getElementById('add-video-link')?.addEventListener('click', () => addLinkRow(videoLinksList));
  addLinkRow(partLinksList);
  addLinkRow(videoLinksList);

  function collectLinks(container) {
    return Array.from(container.querySelectorAll('.link-row'))
      .map((row) => ({
        name: row.querySelector('.link-name').value.trim(),
        url: row.querySelector('.link-url').value.trim()
      }))
      .filter((l) => l.name || l.url)
      .map((l) => `${l.name || l.url} | ${l.url || l.name}`)
      .join('\n');
  }

  // --- Category: searchable select + "not listed yet" fallback ---
  const categorySearch = document.getElementById('category-search');
  const categorySelect = document.getElementById('category-select');
  const newCategoryInput = document.getElementById('new-category-input');
  const categoryError = document.getElementById('category-error');
  const placeholderOption = Array.from(categorySelect.options).find((o) => o.value === '');
  const newCategoryOption = Array.from(categorySelect.options).find((o) => o.value === '__new__');
  const allCategoryOptions = Array.from(categorySelect.options).filter((o) => o.value !== '__new__' && o.value !== '');

  function applyCategorySearch() {
    const q = categorySearch.value.trim().toLowerCase();
    const currentValue = categorySelect.value;
    categorySelect.innerHTML = '';
    categorySelect.appendChild(placeholderOption);
    allCategoryOptions
      .filter((o) => !q || o.dataset.label.toLowerCase().includes(q) || o.value === currentValue)
      .forEach((o) => categorySelect.appendChild(o));
    categorySelect.appendChild(newCategoryOption);
    categorySelect.value = currentValue;
  }

  categorySearch.addEventListener('input', applyCategorySearch);

  function updateNewCategoryVisibility() {
    const isNew = categorySelect.value === '__new__';
    newCategoryInput.classList.toggle('hidden', !isNew);
    if (!isNew) newCategoryInput.value = '';
  }

  categorySelect.addEventListener('change', updateNewCategoryVisibility);
  updateNewCategoryVisibility();

  function readCategory() {
    if (categorySelect.value === '') return null;
    if (categorySelect.value === '__new__') {
      const label = newCategoryInput.value.trim();
      return label ? { category: label, categoryId: '' } : null;
    }
    const opt = categorySelect.selectedOptions[0];
    return opt ? { category: opt.dataset.label, categoryId: opt.value } : null;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const category = readCategory();
    categoryError.classList.toggle('hidden', !!category);
    if (!category) {
      categoryError.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    submitBtn.disabled = true;
    status.textContent = strings.submitting;
    status.className = 'mt-3 text-sm text-stone-500';

    const sourceFormData = new FormData(form);
    const stepRows = Array.from(stepsList.querySelectorAll('.step-row'));
    const steps = stepRows.map((row) => ({
      text: row.querySelector('.step-text').value.trim(),
      partLink: '',
      videoLink: ''
    }));

    const upload = new FormData();
    for (const key of ['title', 'productName', 'difficulty', 'estimatedTime', 'notes', 'authorName', 'authorContact', 'website']) {
      upload.set(key, String(sourceFormData.get(key) || ''));
    }
    upload.set('category', category.category);
    upload.set('categoryId', category.categoryId);
    upload.set(
      'tools',
      Array.from(toolsList.querySelectorAll('.tool-input'))
        .map((i) => i.value.trim())
        .filter(Boolean)
        .join('\n')
    );
    upload.set('partLinks', collectLinks(partLinksList));
    upload.set('videoLinks', collectLinks(videoLinksList));
    upload.set('stepsJson', JSON.stringify(steps));

    const coverInput = form.querySelector('input[name="coverImage"]');
    if (coverInput.files?.[0]) upload.set('coverImage', coverInput.files[0]);
    stepRows.forEach((row, i) => {
      const file = row.querySelector('.step-image').files?.[0];
      if (file) upload.set(`stepImage_${i}`, file);
    });

    try {
      const res = await fetch('/api/submit-guide', {
        method: 'POST',
        body: upload
      });
      const result = await res.json();
      if (result.ok) {
        status.textContent = strings.submitted;
        status.className = 'mt-3 text-sm text-emerald-700';
        const link = document.createElement('a');
        link.href = result.issueUrl;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = ' ' + strings.viewSubmission;
        link.className = 'underline';
        status.appendChild(link);
        form.reset();
        stepsList.innerHTML = '';
        addStep();
        addStep();
        toolsList.innerHTML = '';
        addTool();
        partLinksList.innerHTML = '';
        videoLinksList.innerHTML = '';
        addLinkRow(partLinksList);
        addLinkRow(videoLinksList);
        applyCategorySearch();
        updateNewCategoryVisibility();
      } else {
        status.textContent = result.error || strings.genericError;
        status.className = 'mt-3 text-sm text-red-600';
      }
    } catch {
      status.textContent = strings.networkError;
      status.className = 'mt-3 text-sm text-red-600';
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
