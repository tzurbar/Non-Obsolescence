{
  "name": "non-obsolescence",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "translate": "node scripts/translate.mjs",
    "build:watch": "nodemon --watch src --watch public -e astro,ts,tsx,md,mdx,css,js,svg --exec \"astro build\"",
    "dev:functions": "wrangler pages dev dist --live-reload --port 8788",
    "dev:full": "concurrently -k -n astro,wrangler \"npm:build:watch\" \"npm:dev:functions\"",
    "review": "node scripts/review.mjs",
    "review:web": "node scripts/review-server.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.5",
    "gray-matter": "^4.0.3",
    "nodemon": "^3.1.14",
    "wrangler": "^4.125.0"
  }
}
