---
import Layout from '../../layouts/Layout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { getCollection } from 'astro:content';
import { byLocale, locales, defaultLocale } from '../../lib/content';

export async function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const guides = byLocale(await getCollection('guides'), locale);
---

<Layout title="Home">
  <HomeContent locale={locale} guides={guides} />
</Layout>
