---
import Layout from '../../../layouts/Layout.astro';
import GuidesList from '../../../components/GuidesList.astro';
import { getCollection } from 'astro:content';
import { byLocale, locales, defaultLocale } from '../../../lib/content';
import { t as uiT } from '../../../lib/i18n';

export async function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const guides = byLocale(await getCollection('guides'), locale);
const categories = byLocale(await getCollection('categoriesGuides'), locale);
---

<Layout title={uiT(locale).guides.title}>
  <GuidesList locale={locale} guides={guides} categories={categories} />
</Layout>
