---
import Layout from '../../../layouts/Layout.astro';
import DataContent from '../../../components/DataContent.astro';
import { getCollection } from 'astro:content';
import { byLocale, locales, defaultLocale } from '../../../lib/content';
import { t as uiT } from '../../../lib/i18n';

export async function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const fixability = byLocale(await getCollection('fixability'), locale);
const materials = byLocale(await getCollection('materials'), locale);
const fixabilityCategories = byLocale(await getCollection('categoriesFixability'), locale);
const materialsCategories = byLocale(await getCollection('categoriesMaterials'), locale);
---

<Layout title={uiT(locale).data.title}>
  <DataContent
    locale={locale}
    fixability={fixability}
    materials={materials}
    fixabilityCategories={fixabilityCategories}
    materialsCategories={materialsCategories}
  />
</Layout>
